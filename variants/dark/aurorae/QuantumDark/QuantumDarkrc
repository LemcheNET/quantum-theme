# Quantum Dark - Aurorae theme config
# Layout values are jomada's originals from Moerc and are unmodified.
# Text colours are Breeze Dark's window-title foregrounds, and the text shadow is dark
# rather than white - a white shadow under light text glows on a dark frame.

[General]
ActiveTextColor=252,252,252
InactiveTextColor=161,169,177
TitleAlignment=Center
TitleVerticalAlignment=Center
UseTextShadow=true
ActiveTextShadowColor=0,0,0,180
InactiveTextShadowColor=0,0,0,140
TextShadowOffsetX=0
TextShadowOffsetY=1
LeftButtons=XIA
Shadow=true
Animation=1

[Layout]
BorderLeft=2
BorderRight=2
BorderBottom=5
TitleEdgeTop=4
TitleEdgeBottom=4
TitleEdgeLeft=7
TitleEdgeRight=7
TitleBorderLeft=3
TitleBorderRight=3
TitleHeight=15
ButtonWidth=22
ButtonHeight=22
ButtonSpacing=8
ButtonMarginTop=2
ButtonMarginLeft=3
ExplicitButtonSpacer=0
PaddingTop=35
PaddingBottom=90
PaddingRight=76
PaddingLeft=76
TitleEdgeTopMaximized=4
TitleEdgeBottomMaximized=4
TitleEdgeLeftMaximized=4
TitleEdgeRightMaximized=4
