# Everything that differs between the variants. Nothing else should.
# Sourced by lib/common.sh with `set -a`; shell syntax, no logic.

SLUG=dark
ID=QuantumDark
NAME="Quantum Dark"

# Stock scheme this variant is derived from, by name. Every colour is read out of
# the installed file at run time, so the palette follows Breeze updates.
BASE_SCHEME=BreezeDark

# Icon theme. A dependency, not shipped: 19,873 files and 130 MiB.
ICON_THEME=Slot-Dark-Icons
ICON_SUBDIR="Slot Icons Themes/Slot-Dark-Icons"

# breeze_cursors is the dark cursor with a light outline, and it is what KDE's own
# Breeze Dark uses. The outline keeps it visible on this variant's dark surfaces.
# Breeze_Snow is the white one; switch to it if you prefer a white pointer.
CURSOR_THEME=breeze_cursors

# What GTK apps and XDG-portal consumers (Electron apps among them) are told.
PORTAL_PREF=prefer-dark
GTK_PREFER_DARK=1

# What uninstall.sh reverts to: KDE's own stock global theme, matched to this variant
# so a dark desktop does not come back light. Resolved at run time against what the
# host actually has, with org.kde.breeze.desktop as the universal fallback.
STOCK_LNF=org.kde.breezedark.desktop
