# Settings both variants share. Variant-specific facts live in
# variants/<slug>/variant.env; these are the ones that are the same either way.
#
# Read by lib/common.sh (sourced) and by packaging/stamp-metadata.py (parsed), so
# contents/defaults, install.sh and verify.sh cannot disagree about them.

# Application style. The theme's whole premise is that the titlebar, the app toolbar
# and the window body are one colour, and that depends on the Qt style honouring the
# KDE colour scheme's Window and Header groups. Fusion does not.
WIDGET_STYLE=Breeze

# Breeze button convention. Moe intends them on the left; for that, swap these.
BUTTONS_LEFT=M
BUTTONS_RIGHT=IAX

# The Aurorae plugin id KWin itself writes on Plasma 6.6. Note that the plugin lives
# under org.kde.kdecoration3 while the kwinrc group is still org.kde.kdecoration2.
AURORAE_PLUGIN=org.kde.kwin.aurorae.v2
KDECORATION_GROUP=org.kde.kdecoration2
